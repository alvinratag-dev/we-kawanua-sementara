        // Render News Cards
        function renderNews(data) {
            const container = document.getElementById('news-container');
            container.innerHTML = '';
            
            data.forEach((item) => {
                const card = document.createElement('article');
                card.className = "bg-white dark:bg-slate-800 rounded-2xl overflow-hidden shadow-sm hover:shadow-md border border-gray-100 dark:border-slate-700/80 transition-all flex flex-col justify-between group cursor-pointer";
                card.onclick = () => openModal(item.id);

                card.innerHTML = `
                    <div>
                        <div class="relative overflow-hidden h-48">
                            <img src="${item.image}" alt="${item.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                            <span class="absolute top-3 left-3 bg-red-600 text-white text-[10px] font-bold px-2.5 py-1 rounded uppercase tracking-wider shadow">
                                ${item.categoryLabel}
                            </span>
                        </div>
                        <div class="p-4">
                            <div class="flex items-center text-[11px] text-gray-400 mb-2">
                                <span><i class="far fa-user mr-1"></i> ${item.author}</span>
                            </div>
                            <h4 class="font-heading font-bold text-base text-slate-900 dark:text-white group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors line-clamp-2 leading-snug">
                                ${item.title}
                            </h4>
                            <p class="text-xs text-gray-600 dark:text-gray-300 mt-2 line-clamp-3">
                                ${item.summary}
                            </p>
                        </div>
                    </div>
                    <div class="px-4 pb-4 pt-2 border-t border-gray-50 dark:border-slate-700/50 flex justify-between items-center text-xs text-red-600 dark:text-red-400 font-semibold">
                        <span>Baca Selengkapnya</span>
                        <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // Category & City Filter Function
        function filterCategory(cat) {
            const categoryTitle = document.getElementById('current-category-title');

            if (cat === 'semua') {
                renderNews(newsData);
                categoryTitle.innerHTML = `<i class="fas fa-newspaper text-red-600 mr-2"></i> Berita Terkini Sulawesi Utara`;
            } else {
                const filtered = newsData.filter(item => item.category === cat);
                renderNews(filtered.length > 0 ? filtered : newsData);
                categoryTitle.innerHTML = `<i class="fas fa-map-marker-alt text-red-600 mr-2"></i> Berita Wilayah: ${cat.toUpperCase()}`;
            }
        }

        // News Detail Modal Functions
        function openModal(id) {
            const item = newsData.find(n => n.id === id) || newsData[0];
            document.getElementById('modal-title').innerText = item.title;
            document.getElementById('modal-category').innerText = item.categoryLabel;
            document.getElementById('modal-author').innerHTML = `<i class="far fa-user mr-1"></i> ${item.author}`;
            document.getElementById('modal-image').src = item.image;
            document.getElementById('modal-content').innerHTML = item.content;
            
            document.getElementById('news-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('news-modal').classList.add('hidden');
        }

        // Kirim Berita Citizen Journalism Modal Functions
        function openSubmitNewsModal() {
            document.getElementById('submit-news-modal').classList.remove('hidden');
        }

        function closeSubmitNewsModal() {
            document.getElementById('submit-news-modal').classList.add('hidden');
        }

        function handleNewsSubmit(e) {
            e.preventDefault();
            alert('Terima kasih! Berita/laporan Anda telah berhasil terkirim ke Redaksi We Kawanua untuk diverifikasi.');
            document.getElementById('citizen-news-form').reset();
            closeSubmitNewsModal();
        }

        // Poll Submission
        function submitPoll() {
            const selected = document.querySelector('input[name="poll"]:checked');
            if(!selected) {
                alert('Silakan pilih salah satu opsi polling!');
                return;
            }
            document.getElementById('poll-form').classList.add('hidden');
            document.getElementById('poll-result').classList.remove('hidden');
        }

        // Dark/Light Theme Toggle Logic
        const themeToggleBtn = document.getElementById('theme-toggle');
        const themeIcon = document.getElementById('theme-icon');

        themeToggleBtn.addEventListener('click', () => {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                themeIcon.className = 'fas fa-moon text-xs';
            } else {
                document.documentElement.classList.add('dark');
                themeIcon.className = 'fas fa-sun text-xs text-yellow-400';
            }
        });

        // Mobile Nav Drawer Toggle
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const closeMobileBtn = document.getElementById('close-mobile-menu');
        const mobileMenu = document.getElementById('mobile-menu');

        mobileMenuBtn.addEventListener('click', () => mobileMenu.classList.remove('hidden'));
        closeMobileBtn.addEventListener('click', () => mobileMenu.classList.add('hidden'));

        function closeMobileNav() {
            mobileMenu.classList.add('hidden');
        }

        // Initialize On Load
        window.onload = function () {
            renderNews(newsData);
        };
    </script>
</body>
</html>
